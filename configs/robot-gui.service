[Unit]
Description=ROB-GY 6213 Robot Navigation GUI
Documentation=https://github.com/lquan9/NYU_ROB_GY_6213
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__PROJECT_DIR__

# Launch the GUI entry point from the project's virtual environment.
# The `gui` console_script is created by `pip install -e .[dev]` via pyproject.toml.
ExecStart=__VENV_DIR__/bin/gui

# Graceful shutdown: SIGTERM first, then SIGKILL after 15s
KillSignal=SIGTERM
TimeoutStopSec=15

Restart=on-failure
RestartSec=10

# Environment
Environment="PYTHONUNBUFFERED=1"
Environment="DISPLAY=:0"

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=robot-gui

[Install]
WantedBy=multi-user.target
